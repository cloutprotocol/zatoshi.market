# Zcash RPC Configuration
# Public RPC endpoint (can be used client-side)
NEXT_PUBLIC_ZCASH_RPC_URL=https://mainnet.zcashexplorer.app/api

# Private RPC credentials (server-side only; Basic auth for the rpc.zatoshi.market proxy).
# Code reads ZCASH_RPC_USERNAME (not ZCASH_RPC_USER). Set the same pair in the Convex dashboard.
ZCASH_RPC_USERNAME=
ZCASH_RPC_PASSWORD=
# Max wait for the primary RPC before failing over to Tatum/Blockchair (ms)
ZCASH_RPC_TIMEOUT_MS=8000

# Onchain indexer (zord). Server-side base URL used by /api/inscriptions, /api/ordinal-index,
# /api/zcash/inscriptions. Defaults to http://135.181.6.234:3333 when unset.
ORDINAL_INDEX_API_BASE=
# Same, but readable client-side (optional)
NEXT_PUBLIC_ORDINAL_INDEX_API=

# Blockchair API Key (optional - get one at https://blockchair.com/api to avoid rate limits)
# Server-side only for balance checking
BLOCKCHAIR_API_KEY=

# Tatum.io API Configuration (for blockchain RPC calls)
# Get a free key at https://tatum.io
TATUM_API_KEY=
TATUM_ZCASH_RPC_URL=https://zcash-mainnet.gateway.tatum.io/

# Optional: override consensus branch id (decimal or 0x-hex) if every provider is blocked.
# Mainnet NU6.3 (ZIP 258) = 0x37A5165B. Update at the next network upgrade.
# ZCASH_CONSENSUS_BRANCH_ID=0x37A5165B

# Zerdinals API Configuration
NEXT_PUBLIC_ZERDINALS_API_URL=https://zerdinals.com/api

# ZMAPS Configuration
NEXT_PUBLIC_ZMAPS_BLOCK_PRICE=0.10
NEXT_PUBLIC_ZMAPS_TOKEN_TICK=ZORE

# Platform Fee Display (client)
NEXT_PUBLIC_PLATFORM_FEE_ENABLED=false
NEXT_PUBLIC_PLATFORM_FEE_ZATS=20000

# Convex deployment selection (client). CONVEX_DEPLOYMENT is written by `npx convex dev`.
# CONVEX_DEPLOYMENT=dev:<name>
# 1) Direct URL (overrides everything if set)
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# 2) Or use env switch with per-env URLs
NEXT_PUBLIC_CONVEX_ENV=dev
NEXT_PUBLIC_CONVEX_URL_DEV=
NEXT_PUBLIC_CONVEX_URL_PROD=

# Split fee policy for UTXO split UI (client)
# Enforced minimum network fee used by backend as well

# Token contract address shown on the landing page. Unset renders "CONTRACT: TBA".
NEXT_PUBLIC_CONTRACT_ADDRESS=
